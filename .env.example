# Database（建議本地：npx prisma dev，或 Neon / Supabase 的 postgresql:// URL）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/playplayplay"

# Auth.js — 產生：openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# LINE Login — https://developers.line.biz/
LINE_CLIENT_ID=""
LINE_CLIENT_SECRET=""

# 首次 Google 登入後，執行 seed 可自動升級為超級管理員
SEED_SUPER_ADMIN_EMAIL="your@gmail.com"

# 若曾用 LINE 登入產生另一個使用者，合併至上述信箱帳號（見 scripts/merge-line-to-super-admin.mjs）
# SEED_SUPER_ADMIN_LINE_SUB="LINE的providerAccountId"

# LINE Messaging API 推播
# LINE_CHANNEL_ACCESS_TOKEN=""

# DUPR API（選填；會員填 DUPR ID 後可按「從 DUPR 帶入」自動填入名稱與積分）
# Partner read-only token（擇一）：
# DUPR_API_KEY=""
# 或 client 憑證換 token：
# DUPR_CLIENT_ID=""
# DUPR_CLIENT_SECRET=""
# DUPR_API_BASE_URL="https://api.dupr.gg"
# DUPR_API_VERSION="v1.0"

# Email（選填 SMTP）
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@playplayplay.app"

# Cron 開課提醒
# CRON_SECRET=""
